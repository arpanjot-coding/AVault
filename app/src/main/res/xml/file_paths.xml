<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Restrict external storage exposure strictly to the app recordings directory -->
    <external-path name="recordings" path="Recordings/AVault" />
    <external-path name="recordings_legacy" path="Recordings/ShizuCalls" />
    <external-files-path name="ext_recordings" path="Recordings" />
    <files-path name="internal_recordings" path="Recordings" />

    <!-- Restrict cache exposure strictly to transient sharing and playback subdirectories -->
    <cache-path name="shared_audio" path="shared_audio" />
    <cache-path name="secure_playback" path="secure_playback" />
</paths>
